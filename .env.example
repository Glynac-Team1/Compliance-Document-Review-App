# Database & Cache
DATABASE_URL=postgresql+asyncpg://compliance:compliance@postgres:5432/compliance_review
REDIS_URL=redis://redis:6379/0

# LLM Provider Configuration
# Supported providers: gemini, groq, openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=
# Comma-separated list of fallback providers if the primary provider fails (e.g. openrouter,groq)
LLM_FALLBACK_PROVIDERS=openrouter,groq
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3
LLM_RETRY_MIN_SECONDS=1
LLM_RETRY_MAX_SECONDS=8
ANALYSIS_TASK_MAX_RETRIES=2
ANALYSIS_TASK_RETRY_BASE_SECONDS=30
ANALYSIS_CLAIM_LEASE_SECONDS=900

# Google Gemini Settings (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq Settings (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Settings (OpenAI-compatible multi-model gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Compliance Document Review

# Security & Session
SESSION_SECRET=replace-with-a-long-random-value
OFFICER_SIGNUP_CODE=replace-with-a-strong-one-time-code

# Storage & Upload Constraints
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]
PUBLIC_STORAGE_URL=http://localhost:9000

# Brevo Transactional Email & Frontend URL
BREVO_API_KEY=xkeysib-replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME="Northstar Compliance"
FRONTEND_URL=http://localhost:3000
